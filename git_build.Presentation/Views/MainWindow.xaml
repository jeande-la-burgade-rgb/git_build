<Window x:Class="git_build.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Grid Margin="10">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <!-- MASTER -->
    <ListBox Grid.Column="0"
             ItemsSource="{Binding Books}"
             SelectedItem="{Binding SelectedBook}" d:ItemsSource="{d:SampleData ItemCount=5}">

        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Title}" />
            </DataTemplate>
        </ListBox.ItemTemplate>

    </ListBox>

    <!-- DETAIL -->
    <StackPanel Grid.Column="1"
            Margin="20,0,0,0">

        <TextBlock Text="Book Details"
               FontSize="20"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

        <TextBlock Text="Title:" FontWeight="Bold"/>
        <TextBlock Text="{Binding SelectedBook.Title}"
               Margin="0,0,0,10"/>

        <TextBlock Text="ISBN:" FontWeight="Bold"/>
        <TextBlock Text="{Binding SelectedBook.ISBN}"/>

    </StackPanel>

</Grid>
</Window>